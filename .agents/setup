#!/usr/bin/env bash
# Prepares an Amp orb for VYRN. The inventory comes from DESIGN.md and spec/ (mainly
# 11-build.md, 06-platform.md, 04-protocol.md §vectors, 09-chain.md). It installs the toolchain
# that rust-toolchain.toml pins, runs vx/build.sh and warms the workspace. Production-only
# hardware (ef_vi/Onload NICs, PTP, 1 GiB huge pages, isolcpus, NVMe arrays, L1 nodes, HSMs) is
# out of scope: DEV uses the sim and kernel_udp backends (06 §DEV, 11 L140).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# vxc pin: 11-build.md L95 and L908 (vx/TOOLCHAIN). vxc v0.0.4 links against LLVM/MLIR 22.
VX_TAG="v0.0.4"
# The spec's 3a89e3c7 is the annotated tag object; it points at this commit.
VX_TAG_OBJECT="3a89e3c761b60270f257521277c174c9e9a784c3"
VX_COMMIT="c6dffec704182d98c271c93afefba1c38ba18d21"
VX_LLVM=22
VX_SRC="$HOME/.local/src/vx"
LOCAL_BIN="$HOME/.local/bin"

# Installer scripts piped to a shell are pinned to a tag or commit and checked against these
# sha256s (CDPI audit S9). To move a pin, fetch the new URL, review the diff, then update both.
RUSTUP_INIT_URL="https://raw.githubusercontent.com/rust-lang/rustup/1.29.3/rustup-init.sh"
RUSTUP_INIT_SHA256="d890e2fef6fa991b19cde2e608199bc1dca4e37f41f884edf8849ff693048de6"
BINSTALL_URL="https://raw.githubusercontent.com/cargo-bins/cargo-binstall/v1.27.0/install-from-binstall-release.sh"
BINSTALL_SHA256="d3a93702160e0ec03e2a4e996855db1f01adee801fb84a43add24e0877ef8eae"
FOUNDRYUP_URL="https://raw.githubusercontent.com/foundry-rs/foundryup/d8a3201f2a7a2a0b85201e9cbd297a6800dc29bf/foundryup-init.sh"
FOUNDRYUP_SHA256="5a8990dff59498a094cb3562ed4be917b3000f32781b50c2b60b399b4ea37dd7"
# apt.llvm.org's signing key (fingerprint 6084F3CF814B57C1CF12EFD515CF4D18AF4F7421): the trust
# root of the LLVM packages, so it is checked like the installers.
LLVM_KEY_URL="https://apt.llvm.org/llvm-snapshot.gpg.key"
LLVM_KEY_SHA256="8b2a587ffd672c4687e7581dad4b2f6c1bb2ad6b480cd9771ba2ff48e0b8c75d"

# Downloads $1 to the file $3 and fails unless its sha256 is $2.
fetch_checked() {
  curl --proto '=https' --tlsv1.2 -fsSL "$1" -o "$3"
  echo "$2  $3" | sha256sum -c --quiet -
}

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

# Refresh the apt index at most once per run, and again only after llvm_repo adds a repository.
apt_fresh=0

apt_install_missing() {
  local missing=()
  for pkg in "$@"; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
  if ((${#missing[@]})); then
    if ((!apt_fresh)); then
      sudo apt-get update -qq
      apt_fresh=1
    fi
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
  fi
}

apt_base() {
  # C shim and general build tools; python3 runs the protocol vectors (04 §vectors, `python3 -I`);
  # meson/ninja/pyelftools/libnuma/ibverbs headers build vendored DPDK for the net_ring test
  # (06 L1216, 11 L740); z3 and the libs below are vxc's build dependencies.
  apt_install_missing build-essential cmake pkg-config git curl ca-certificates gnupg \
    python3 meson ninja-build python3-pyelftools libnuma-dev libibverbs-dev \
    libffi-dev libz3-dev z3 zlib1g-dev libzstd-dev libedit-dev libxml2-dev
}

rustup_install() {
  if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    fetch_checked "$RUSTUP_INIT_URL" "$RUSTUP_INIT_SHA256" /tmp/rustup-init.sh
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal --default-toolchain none
  fi
}

toolchains() {
  # The pin from rust-toolchain.toml is the default. A separate `stable` toolchain would download
  # the same rustc again under another name, and a different one once stable moves past the pin.
  rustup toolchain install
  local pin minor
  pin="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)"
  rustup default "$pin" >/dev/null
  # Miri, TSan/ASan (-Zsanitizer) and cargo-fuzz need nightly (11 L608, L901, L1935). Install it
  # once: rerunning `rustup toolchain install nightly` on a restored snapshot pulls the day's
  # nightly and forces a Miri sysroot rebuild.
  if ! rustup run nightly cargo miri --version >/dev/null 2>&1; then
    rustup toolchain install nightly --profile minimal --component miri,rust-src,llvm-tools-preview
  fi
  # B4 build C uses the rustc release before the pin (11 L1546).
  minor="${pin#1.}"
  minor="${minor%%.*}"
  rustup toolchain install "1.$((minor - 1))" --profile minimal
}

miri_sysroot() {
  # Runs after llvm_for_rust: .cargo/config.toml sets `linker = "clang"`, and Miri's sysroot
  # build (compiler_builtins' build script) links with it.
  cargo +nightly miri setup >/dev/null
}

llvm_repo() {
  local version="$1" codename
  codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
  local list="/etc/apt/sources.list.d/llvm-${version}.list"
  [[ -f "$list" ]] && return 0
  if [[ ! -f /usr/share/keyrings/llvm-snapshot.gpg ]]; then
    fetch_checked "$LLVM_KEY_URL" "$LLVM_KEY_SHA256" /tmp/llvm-snapshot.gpg.key
    sudo gpg --dearmor -o /usr/share/keyrings/llvm-snapshot.gpg </tmp/llvm-snapshot.gpg.key
  fi
  echo "deb [signed-by=/usr/share/keyrings/llvm-snapshot.gpg] http://apt.llvm.org/${codename}/ llvm-toolchain-${codename}-${version} main" |
    sudo tee "$list" >/dev/null
  # Make apt_install_missing refresh the index for the new repository.
  apt_fresh=0
}

llvm_for_rust() {
  # Cross-language LTO needs clang/lld from the same LLVM major as rustc (11 L627-631); CI also
  # runs clang-tidy, clang-format, llvm-objdump and nm (11 L716, L736, L765, L1929).
  local major
  major="$(rustc -vV | sed -n 's/^LLVM version: \([0-9]*\).*/\1/p')"
  llvm_repo "$major"
  apt_install_missing "clang-$major" "lld-$major" "llvm-$major" "clang-tidy-$major" "clang-format-$major"
  local bin="/usr/lib/llvm-$major/bin"
  for tool in clang clang++ lld ld.lld clang-tidy clang-format llvm-objdump llvm-nm llvm-ar llvm-config; do
    if [[ "$(readlink "/usr/local/bin/$tool" 2>/dev/null)" != "$bin/$tool" ]]; then
      sudo ln -sfn "$bin/$tool" "/usr/local/bin/$tool"
    fi
  done
}

llvm_for_vx() {
  llvm_repo "$VX_LLVM"
  apt_install_missing "llvm-$VX_LLVM" "llvm-$VX_LLVM-dev" "llvm-$VX_LLVM-tools" "clang-$VX_LLVM" \
    "lld-$VX_LLVM" "libmlir-$VX_LLVM-dev" "mlir-$VX_LLVM-tools" "libpolly-$VX_LLVM-dev"
}

# VX-WORKAROUND W-10 (issue to file): makes vxc's two unsorted build scripts list in name order
# (see vxc_build). Idempotent; drops their cached build-script output when it patches.
vxc_sort_build_scripts() {
  local src="${CARGO_HOME:-$HOME/.cargo}/registry/src"
  local mlir tbl patched=()
  mlir="$(ls -d "$src"/*/mlir-sys-220.0.2/build.rs)"
  tbl="$(ls -d "$src"/*/tblgen-0.9.1/build.rs)"
  if ! grep -q 'VYRN W-10' "$mlir"; then
    perl -0pi -e 's~for entry in fs::read_dir\(&directory\)\? \{\n(\s*)if let Some\(name\) = entry\?\.path\(\)\.file_name\(\)~// VYRN W-10: name order.\n$1let mut paths = fs::read_dir(&directory)?.map(|e| e.map(|e| e.path())).collect::<Result<Vec<_>, _>>()?;\n$1paths.sort();\n$1for entry in paths {\n$1if let Some(name) = entry.file_name()~' "$mlir"
    patched+=(mlir-sys)
  fi
  if ! grep -q 'VYRN W-10' "$tbl"; then
    perl -0pi -e 's{\.map\(\|entry\| entry\.path\(\)\)}{.map(|entry| entry.path()) // VYRN W-10: name order.\n                .collect::<std::collections::BTreeSet<_>>()\n                .into_iter()}' "$tbl"
    patched+=(tblgen)
  fi
  grep -q 'VYRN W-10' "$mlir" && grep -q 'VYRN W-10' "$tbl" || {
    echo "vxc_sort_build_scripts: mlir-sys or tblgen build.rs did not match" >&2
    return 1
  }
  # Cargo never re-runs a registry crate's build script on a source change.
  for p in "${patched[@]}"; do
    cargo clean --release --quiet --target-dir "$VX_SRC/target" -p "$p"
  done
}

vxc_build() {
  # No aarch64 Linux release exists for v0.0.4, so build it from the pinned tag on every arch.
  mkdir -p "$LOCAL_BIN" "$(dirname "$VX_SRC")"
  if [[ ! -d "$VX_SRC/.git" ]]; then
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$VX_TAG" \
      https://github.com/vx-lang/Vx.git "$VX_SRC"
  fi
  if [[ "$(git -C "$VX_SRC" rev-parse HEAD)" != "$VX_COMMIT" ||
    "$(git -C "$VX_SRC" rev-parse "refs/tags/$VX_TAG")" != "$VX_TAG_OBJECT" ]]; then
    echo "vx checkout does not match $VX_TAG ($VX_TAG_OBJECT -> $VX_COMMIT)" >&2
    return 1
  fi
  local pin
  pin="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)"
  (
    cd "$VX_SRC"
    [[ -f config.local ]] || LLVM_VERSION="$VX_LLVM" ./setup.sh >/dev/null
    # shellcheck disable=SC1091
    source config.local
    # VX-WORKAROUND W-10 (issue to file): no vxc release binary, so the pin is a local build.
    # Reproducible vxc: one toolchain name (the pin, not `stable` or the
    # rustup default), and the registry and toolchain paths remapped. rust-src turns std's
    # /rustc/<commit> paths into sysroot paths, so the last rule (the last match wins) maps them
    # back. The target dir stays $VX_SRC/target: build.rs embeds it.
    # Two build scripts list a directory unsorted: mlir-sys links every libMLIR*.a of LLVM's
    # libdir in read_dir order, and tblgen archives cc/lib's sources in that order. read_dir
    # order differs between filesystems, so static link order, and vxc's code layout, differed
    # between orbs (a12dedc6… vs da38286d…). Sort both in the extracted registry sources.
    RUSTUP_TOOLCHAIN="$pin" cargo fetch --locked --quiet
    vxc_sort_build_scripts
    local sysroot commit
    sysroot="$(rustup run "$pin" rustc --print sysroot)"
    commit="$(rustup run "$pin" rustc -vV | sed -n 's/^commit-hash: //p')"
    RUSTUP_TOOLCHAIN="$pin" CARGO_TARGET_DIR="$VX_SRC/target" \
      RUSTFLAGS="--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}/registry/src=/cargo/registry/src --remap-path-prefix=$sysroot=/rustc/sysroot --remap-path-prefix=$sysroot/lib/rustlib/src/rust=/rustc/$commit" \
      cargo build --release --locked --quiet
  )
  ln -sfn "$VX_SRC/target/release/vxc" "$LOCAL_BIN/vxc"
}

cargo_tools() {
  if ! command -v cargo-binstall >/dev/null; then
    fetch_checked "$BINSTALL_URL" "$BINSTALL_SHA256" /tmp/binstall-install.sh
    BINSTALL_VERSION=1.27.0 bash /tmp/binstall-install.sh
  fi
  # deny/vet/fuzz/show-asm are named by 11 (L54, L58, L102, L613); nextest is a faster runner for
  # the unit tier; cyclonedx writes the release SBOM (11 L316); vx/build.sh checks the vxc pin
  # with b3sum.
  # One binstall call per tool, b3sum first, so a tool binstall cannot install (cargo-show-asm
  # builds from source) cannot leave vx/build.sh without b3sum. --force: a tool whose binary is
  # gone but which cargo's install metadata still lists is otherwise "already installed".
  local failed=() tool
  for tool in b3sum cargo-deny cargo-vet cargo-fuzz cargo-show-asm:cargo-asm cargo-nextest cargo-cyclonedx; do
    command -v "${tool#*:}" >/dev/null && continue
    cargo binstall --no-confirm --disable-telemetry --force "${tool%%:*}" || failed+=("${tool%%:*}")
  done
  if ((${#failed[@]})); then
    echo "cargo binstall failed for: ${failed[*]}" >&2
    return 1
  fi
}

foundry_install() {
  # Bridge contract work and the B-CHN-4 gas report (09 L1113, L2020).
  if [[ ! -x "$HOME/.foundry/bin/forge" ]]; then
    fetch_checked "$FOUNDRYUP_URL" "$FOUNDRYUP_SHA256" /tmp/foundryup-init.sh
    bash /tmp/foundryup-init.sh >/dev/null
    "$HOME/.foundry/bin/foundryup" --install stable >/dev/null
  fi
}

shell_profile() {
  # ~/.bash_profile exists in orbs, so login shells skip ~/.profile; add the tool paths here.
  local marker="# VYRN toolchain paths"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<'EOF'

# VYRN toolchain paths
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
case ":$PATH:" in *":$HOME/.foundry/bin:"*) ;; *) export PATH="$PATH:$HOME/.foundry/bin" ;; esac
EOF
  fi
}

agent_guidance() {
  local file="$HOME/.config/amp/AGENTS.md" marker="<!-- VYRN orb notes -->"
  mkdir -p "$(dirname "$file")"
  grep -Fqx "$marker" "$file" 2>/dev/null && return 0
  cat >>"$file" <<'EOF'

<!-- VYRN orb notes -->
# VYRN orb notes

- Orbs run x86-64 or aarch64 Linux; `uname -m` says which. Build natively for it. x86-64-v3
  builds and AVX-512 paths need an x86-64 machine.
- `clang`, `lld`, `clang-tidy`, `clang-format` and `llvm-objdump` in /usr/local/bin match
  rustc's LLVM major, as cross-language LTO requires. LLVM/MLIR 22 under /usr/lib/llvm-22 is
  only for building vxc.
- `vxc` v0.0.4 (tag 3a89e3c7, commit c6dffec7) is built from source in ~/.local/src/vx and
  linked into ~/.local/bin, only once vx/ has `.vx` sources and on orbs with at least 4 GiB of
  memory. After adding the first `.vx` file, run `.agents/setup` to build it. Pass
  `-fweak-relaxed-atomics` on aarch64.
- Toolchains: the rust-toolchain.toml pin (default), nightly (miri, sanitizers, cargo-fuzz), and
  the release before the pin for B4 build C. Foundry (`forge`, `anvil`) is in ~/.foundry/bin.
- Use the `sim` or `kernel_udp` NIC backends. ef_vi, DPDK on hardware, PTP, 1 GiB huge pages
  and core pinning are unavailable here; never report DEV numbers as latency results.
EOF
}

warm_workspace() {
  if [[ -x vx/build.sh ]]; then
    # 11 L919: vx/build.sh runs before the Rust build.
    vx/build.sh
  fi
  if [[ -f Cargo.toml ]]; then
    if [[ -f Cargo.lock ]]; then
      cargo fetch --locked
      cargo build --locked --workspace --all-targets
    else
      cargo build --workspace --all-targets
    fi
  else
    echo "No Cargo.toml yet; skipping workspace build."
  fi
  if [[ -f deny.toml ]]; then
    cargo deny fetch
  fi
}

step "apt base packages" apt_base
step "rustup" rustup_install
# The installer cannot update this running script's environment.
# shellcheck disable=SC1091
source "$HOME/.cargo/env"
export PATH="$LOCAL_BIN:$HOME/.foundry/bin:$PATH"
step "rust toolchains" toolchains
step "LLVM matching rustc" llvm_for_rust
step "miri sysroot" miri_sysroot
# Compiling vxc's MLIR lowering needs more than 1.4 GB in one clang++ process; small orbs
# (1.5 GiB cgroup, no swap) OOM-kill it, so skip vxc and its LLVM 22 there.
mem_limit="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)"
if [[ "$mem_limit" == max ]]; then
  mem_limit=$(($(awk '/^MemTotal/ {print $2}' /proc/meminfo) * 1024))
fi
# LLVM/MLIR 22 and the vxc build take most of a cold setup, and only vx/build.sh uses vxc, so
# build it once the repository has Vx sources (the check vx/build.sh makes) or keep it current.
if [[ ! -x "$LOCAL_BIN/vxc" &&
  -z "$(find vx/vyrn-vx-oracle vx/vyrn-vx-client -name '*.vx' -print -quit 2>/dev/null)" ]]; then
  echo "==> vxc $VX_TAG skipped: no Vx sources yet (rerun .agents/setup after adding one)"
elif [[ -x "$LOCAL_BIN/vxc" ]] || ((mem_limit >= 4 * 1024 * 1024 * 1024)); then
  step "LLVM/MLIR $VX_LLVM for vxc" llvm_for_vx
  step "vxc $VX_TAG" vxc_build
else
  echo "==> vxc $VX_TAG skipped: orb memory limit $((mem_limit >> 20)) MiB < 4096 MiB"
fi
step "cargo tools" cargo_tools
step "foundry" foundry_install
step "shell profile" shell_profile
step "agent guidance" agent_guidance
step "warm workspace" warm_workspace
