   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "roundness": null,
   "text": "names the lane: the lane\ndecides V2 with one compare\nand one load",
   "originalText": "names the lane: the lane\ndecides V2 with one compare\nand one load",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
