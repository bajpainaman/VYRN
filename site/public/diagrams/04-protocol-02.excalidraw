  {
   "type": "text",
   "id": "gen_n",
   "x": 90,
   "y": 300,
   "width": 299.52,
   "height": 67.5,
   "strokeColor": "#565A6B",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "angle": 0,
   "seed": 883470496,
   "version": 1,
   "versionNonce": 1296163645,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "roundness": null,
   "text": "+1 each time the slot is reused,\nso a stale SessionId never\nmatches a new session",
   "originalText": "+1 each time the slot is reused,\nso a stale SessionId never\nmatches a new session",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "lane_n",
   "x": 460,
   "y": 300,
   "width": 252.72,
   "height": 67.5,
   "strokeColor": "#565A6B",
   "backgroundColor": "transparent",
