   "boundElements": null,
   "link": null,
   "locked": false,
   "updated": 1,
   "roundness": null,
   "text": "the lane-op records after it (up to the next SYNC) are ordered after\nstep T and before step T+1. Emitted lazily, only before the first\nrecord after a new step.",
   "originalText": "the lane-op records after it (up to the next SYNC) are ordered after\nstep T and before step T+1. Emitted lazily, only before the first\nrecord after a new step.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true,
   "baseline": 14
  },
