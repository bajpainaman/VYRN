   "boundElements": null,
   "link": null,
   "locked": false,
   "updated": 1,
   "roundness": null,
   "text": "apply step T only when W_k ≥ T − 1 for every k.\nbefore step T, apply every pending lane-op record whose\nSYNC position is < T, in any order across channels.",
   "originalText": "apply step T only when W_k ≥ T − 1 for every k.\nbefore step T, apply every pending lane-op record whose\nSYNC position is < T, in any order across channels.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "containerId": null,
   "autoResize": true,
   "baseline": 14
  },
