# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable runtime output (reviews, reports, live state); the brief, design.json and DESIGN.md stay tracked
/.impeccable/review/
/.impeccable/audit/
/.impeccable/critique/
/.impeccable/live/
/.impeccable/hook.cache.json

# dark-theme diagram copies, written by scripts/sync-diagrams.mjs
/public/diagrams/*-dark.svg
